# TEMPLATE ONLY: finish hosted startup and custody before creating tinfoil-config.yml.
# Keep the CVM version aligned with the official Tinfoil template.
cvm-version: 0.14.7
cpus: 2
memory: 8192

containers:
  - name: tilde-runner
    image: ghcr.io/kurtykalabs/tilde-runner@sha256:REPLACE_WITH_PUBLISHED_IMAGE_DIGEST
    # Add the implemented hosted command, secret names, volume and network policy.
    # The current image's verify-inference default exits; it does not serve chat.

shim:
  upstream-port: 8937
  paths:
    - /v1/commands
